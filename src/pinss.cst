// System Clock and Reset
IO_LOC "sys_clk" 4;
IO_PORT "sys_clk" PULL_MODE=UP;
IO_LOC "sys_rst_n" 88;
IO_PORT "sys_rst_n" PULL_MODE=UP;

// Shared I2C Bus (Sensor + OLED)
IO_LOC "i2c_sda" 53;
IO_PORT "i2c_sda" PULL_MODE=UP DRIVE=8;
IO_LOC "i2c_scl" 52;
IO_PORT "i2c_scl" PULL_MODE=UP DRIVE=8;

// Onboard LEDs for AI Visualizer
IO_LOC "led[0]" 15;
IO_PORT "led[0]" PULL_MODE=UP DRIVE=8;
IO_LOC "led[1]" 16;
IO_PORT "led[1]" PULL_MODE=UP DRIVE=8;
IO_LOC "led[2]" 17;
IO_PORT "led[2]" PULL_MODE=UP DRIVE=8;
IO_LOC "led[3]" 18;
IO_PORT "led[3]" PULL_MODE=UP DRIVE=8;